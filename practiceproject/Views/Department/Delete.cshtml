@model practiceproject.Models.Department
@{

    Layout = "_DashboardLayout";
    ViewData["Title"] = "Delete Department";

}


<div class="container mt-4">
    <h2 class="mb-4">Delete Department</h2>
    <div class="row">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body">
                    <form asp-action="DeleteConfirm" method="post">
                        <input type="hidden" asp-for="@Model.Departid" />
                        <div class="mb-3">
                            <label asp-for="DepartmentName" class="form-label">Department Name</label>
                            <input asp-for="DepartmentName" class="form-control" readonly />
                        </div>
                        <div class="mb-3">
                            <label asp-for="DepartmentDescription" class="form-label">Description</label>
                            <textarea asp-for="DepartmentDescription" class="form-control" rows="3" readonly></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>