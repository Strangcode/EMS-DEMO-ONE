
@model practiceproject.Models.Department

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Create Department";
}

<div class="container mt-4">

    <h2 class="mb-4">Create Department</h2>

    <div class="row">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card">
                <div class="card-body">

                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="DepartmentName"
                                   class="form-label">
                                Department Name
                            </label>

                            <input asp-for="DepartmentName"
                                   class="form-control"
                                   placeholder="Enter department name" />

                            <span asp-validation-for="DepartmentName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DepartmentDescription"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="DepartmentDescription"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter description"></textarea>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

