@model practiceproject.ViewModel.AttendanceViewModel


@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Create Attendance Record";
}

<div class="container">
    <form method="post" asp-action="Create" asp-controller="Attendace">
    
     <div class="row">
   
     <div class="col-12 col-md-6 mb-3">
            <label class="form-label">Select Employee</label>
            <select asp-for="Attendances_.EmployeeId" class="form-control" asp-items="Model.EmployeeList">
                <option value=""> Select Employee </option>
            </select>
            <span asp-validation-for="Attendances_.EmployeeId" class="text-danger"></span>
    </div>       

    <div class="col-12 col-md-6 mb-3">

        <label class="form-lable">Date</label>
        <input type="datetime-local" class="form-control" asp-for="Attendances_.Date"/>
        <span asp-validation-for="Attendances_.Date" class="text-danger"></span>

    </div>

    <div class="col-12 col-md-6 mb-3">
       <label class="form-label">Status</label>
       <select class="form-control" asp-for="Attendances_.Status" asp-items="Html.GetEnumSelectList<AttendanceStatus>()">
            <option value="">Status</option>
       </select>
       <span asp-validation-for="Attendances_.Status" class="text-danger"></span>
    </div>
   
    <div class="d-flex flex-column col-12 flex-md-row  gap-2">
         <button type="submit" class="btn btn-primary w-100">
             Create Record
         </button>
                <button type="reset" class="btn btn-secondary w-100">
                  reset
          </button>
    </div>
    </div>
   
</form>
</div>

